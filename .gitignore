# ==============================
# Dependencies
# ==============================
node_modules/
**/node_modules/

# ==============================
# Environment variables / secrets
# ==============================
.env
.env.*
**/.env
**/.env.*

# Allow only safe example files
!.env.example
!**/.env.example
!.client/.env.example
!client/.env.example

# ==============================
# Build outputs
# ==============================
dist/
client/dist/
server/dist/
build/

# ==============================
# Logs
# ==============================
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# ==============================
# OS files
# ==============================
.DS_Store
Thumbs.db
desktop.ini

# ==============================
# IDE
# ==============================
.vscode/*
!.vscode/extensions.json

# ==============================
# Temporary files
# ==============================
*.tmp
*.temp

# ==============================
# Private keys / certificates
# ==============================
*.pem
*.key
*.p12
*.pfx

# ==============================
# Local database files
# ==============================
*.sqlite
*.sqlite3
*.db