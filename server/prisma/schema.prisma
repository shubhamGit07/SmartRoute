
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  RIDER
  ADMIN
}

enum OrderStatus {
  PENDING
  ACCEPTED
  PICKED_UP
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

enum OrderPriority {
  STANDARD
  EXPRESS
}

model User {
  id           String   @id @default(cuid())
  name          String
  email         String   @unique
  passwordHash  String?
  role          UserRole @default(CUSTOMER)

  riderProfile Rider?
  orders       Order[] @relation("CustomerOrders")

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([role])
}

model Rider {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  available   Boolean  @default(false)
  latitude   Float?
  longitude  Float?
  heading    Float?
  lastSeen   DateTime?

  orders     Order[]  @relation("RiderOrders")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([available])
  @@index([lastSeen])
}

model Order {
  id              String        @id @default(cuid())
  itemDescription  String
  priority         OrderPriority @default(STANDARD)
  status           OrderStatus  @default(PENDING)

  pickupName       String
  pickupAddress    String
  pickupLat       Float
  pickupLng       Float

  dropName        String
  dropAddress     String
  dropLat        Float
  dropLng        Float

  roadDistanceKm  Float?
  etaMinutes     Int?
  fare           Float?
  optimizedSequence Int?

  customerId      String
  customer        User          @relation("CustomerOrders", fields: [customerId], references: [id], onDelete: Restrict)

  riderId         String?
  rider           Rider?        @relation("RiderOrders", fields: [riderId], references: [id], onDelete: SetNull)

  events          DeliveryEvent[]

  acceptedAt      DateTime?
  pickedUpAt     DateTime?
  deliveredAt    DateTime?
  cancelledAt    DateTime?

  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([status, createdAt])
  @@index([customerId, createdAt])
  @@index([riderId, status])
  @@index([priority, status])
  @@index([createdAt])
}

model DeliveryEvent {
  id          String      @id @default(cuid())
  orderId     String
  order       Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)

  status      OrderStatus
  description String?
  latitude    Float?
  longitude  Float?
  actor      String?

  createdAt  DateTime    @default(now())

  @@index([orderId, createdAt])
  @@index([status, createdAt])
}

model BenchmarkLog {
  id              String   @id @default(cuid())
  experimentId     String
  seed            Int
  batchSize       Int
  algorithm        String

  distanceKm      Float
  durationMinutes Float
  computeMs       Float

  orderCount      Int?
  improvementPct  Float?
  notes           String?

  createdAt       DateTime @default(now())

  @@index([experimentId])
  @@index([experimentId, algorithm])
  @@index([createdAt])
  @@index([algorithm, createdAt])
}
